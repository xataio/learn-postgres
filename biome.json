{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["components/shell/readline.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noVoidTypeReturn": "off"
          }
        }
      }
    },
    {
      "includes": [
        "components/shell/Terminal.tsx",
        "components/shell/format.ts",
        "components/shell/readline.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useTemplate": "off"
          }
        }
      }
    },
    {
      "includes": ["public/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      "includes": ["db/migrations/meta/**"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
